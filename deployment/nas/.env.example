# Copy to deployment/nas/.env. Do not commit the real file.
MYSQL_DATABASE=ai_news
MYSQL_USER=portal_app
# Use two different long random passwords. Do not reuse the root password in app.py.
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
# Used only by the NAS Task Scheduler to authorize the internal sync endpoints.
CRON_SECRET=replace-with-another-long-random-secret

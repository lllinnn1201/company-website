# Copy this file to .env and fill in the password used by your local MySQL server.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_news
MYSQL_USER=portal_app
MYSQL_PASSWORD=change-this-password
# Required to protect /api/sync/news.  Use a long random string and also add it
# to the Vercel project's environment variables as CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-secret
